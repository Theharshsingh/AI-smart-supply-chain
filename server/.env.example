# MongoDB connection string (required)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/supplychain

# Google Gemini API key (required for chatbot)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# JWT secret (optional, has default)
JWT_SECRET=supplychain_secret_2024_change_in_production

# Server port (optional, default: 4000)
PORT=4000

# Client URL for CORS (optional)
CLIENT_URL=http://localhost:5173